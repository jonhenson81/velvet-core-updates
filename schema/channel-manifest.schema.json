{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jonhenson81/velvet-core-updates/main/schema/channel-manifest.schema.json",
  "title": "Velvet Core channel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "channel",
    "versionCode",
    "versionName",
    "minAndroidSdk",
    "supportedAbis",
    "apkUrl",
    "sha256",
    "signingCertificateSha256",
    "releaseNotes",
    "publishedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "const": "com.velvetcore.companion" },
    "channel": { "enum": ["development", "beta", "alpha", "stable"] },
    "versionCode": { "type": "integer", "minimum": 1 },
    "versionName": { "type": "string", "minLength": 1 },
    "minAndroidSdk": { "type": "integer", "minimum": 30 },
    "supportedAbis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["arm64-v8a", "armeabi-v7a", "x86_64", "x86"] }
    },
    "apkUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "signingCertificateSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "releaseNotes": { "type": "string" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "mandatory": { "type": "boolean", "default": false },
    "minimumSupportedVersionCode": { "type": "integer", "minimum": 1 }
  }
}
